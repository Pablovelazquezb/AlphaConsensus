# ─────────────────────────────────────────────────────────────
# AlphaConsensus — variables de entorno (copiar a .env)
# NUNCA commitear el .env real. El .gitignore ya lo excluye.
# ─────────────────────────────────────────────────────────────

# --- Apify: scraping de X/Twitter (ver README, sección "Datos de X") ---
# https://console.apify.com/account/integrations
APIFY_TOKEN=
# Actor por defecto (soporta búsqueda y perfiles/timeline).
# Alternativas: apidojo/tweet-scraper, apidojo/twitter-scraper-lite
APIFY_ACTOR=apidojo/twitter-profile-scraper
# JSON extra que se fusiona con el input del actor (opcional).
# APIFY_INPUT_JSON={"sort":"Latest","tweetLanguage":"en"}

# --- X API oficial v2 (alternativa a Apify) ---
X_BEARER_TOKEN=

# --- Capa LLM (opcional; por defecto se usa el parser de reglas) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# --- Broker (Fase 3; el demo usa el simulador interno) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# --- Bargo: divulgaciones del Congreso (STOCK Act) ---
# https://www.bargo.ai/free-apis/congress — opcional; sin key hay cuota anónima baja.
BARGO_API_KEY=
